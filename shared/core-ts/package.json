{
  "name": "@modelflare/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Modelflare client logic that every Modelflare plugin bundles at build time.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "~6.0.3"
  }
}
